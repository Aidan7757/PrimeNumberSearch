# Makefile for CUDA Prime Number Search (with fallback support)

# Compiler
CC = gcc
CFLAGS = -O3 -std=c99 -Wall -Wextra

# CUDA compiler (if available)
NVCC ?= nvcc
CUDA_ARCH = -arch=sm_52
NVCC_FLAGS = $(CUDA_ARCH) -O3 -std=c++11

# Check for CUDA availability
HAVE_CUDA := $(shell which nvcc 2>/dev/null)

# Source files
CUDA_SOURCES = src/search_methods_cuda.cu src/fft_multiply.cu src/schonhage_strassen.cu
HOST_SOURCES = cuda_prime_search.c src/search_methods_cuda_host.c src/schonhage_strassen_host.c

# Object files
CUDA_OBJECTS = $(CUDA_SOURCES:.cu=.o)
HOST_OBJECTS = $(HOST_SOURCES:.c=.o)

# Target executable
TARGET = cuda_prime_search

# Conditional compilation
ifdef HAVE_CUDA
    # CUDA is available
    COMPILE_CUDA = 1
    CUDA_INCLUDE = -I$(shell dirname $(HAVE_CUDA))/../include
    CUDA_LIB = -L$(shell dirname $(HAVE_CUDA))/../lib64
    LIBS = $(CUDA_LIB) -lcuda -lcudart
    INCLUDES = -I. $(CUDA_INCLUDE) -DHAVE_CUDA
    LINKER = $(NVCC)
    LINK_FLAGS = $(CUDA_ARCH)
else
    # CUDA fallback
    COMPILE_CUDA = 0
    LIBS = -lm
    INCLUDES = -I.
    LINKER = $(CC)
    LINK_FLAGS = 
endif

# Default target
all: $(TARGET)

# Build the target
$(TARGET): $(HOST_OBJECTS)
ifeq ($(COMPILE_CUDA),1)
	$(LINKER) $(LINK_FLAGS) -o $@ $^ $(LIBS)
else
	$(LINKER) $(LINK_FLAGS) -o $@ $^ $(LIBS)
endif

# Compile C source files
%.o: %.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Compile CUDA source files (only if CUDA is available)
ifeq ($(COMPILE_CUDA),1)
%.o: %.cu
	$(NVCC) $(NVCC_FLAGS) $(INCLUDES) -c $< -o $@
else
# Create a dummy object file for CUDA sources when CUDA is not available
src/search_methods_cuda.o:
	@echo "Creating fallback object for CUDA sources..."
	@touch $@
endif

# Clean build artifacts
clean:
	rm -f $(CUDA_OBJECTS) $(HOST_OBJECTS) $(TARGET)

# Check CUDA installation
check-cuda:
ifeq ($(COMPILE_CUDA),1)
	@echo "CUDA installation found:"
	@$(NVCC) --version
else
	@echo "CUDA not found. Install CUDA toolkit for GPU acceleration."
	@echo "The program will build with CPU fallback support."
endif

# Show build configuration
show-config:
	@echo "Build Configuration:"
	@echo "  CUDA Available: $(COMPILE_CUDA)"
	@echo "  Compiler: $(CC)"
ifeq ($(COMPILE_CUDA),1)
	@echo "  CUDA Compiler: $(NVCC)"
	@echo "  CUDA Architecture: $(CUDA_ARCH)"
endif
	@echo "  Include Paths: $(INCLUDES)"
	@echo "  Libraries: $(LIBS)"

# Run with example parameters
run-example: $(TARGET)
	@echo "Running example with Miller-Rabin test..."
	./$(TARGET) 1 1000000 1000100 10

# Install target (optional)
install: $(TARGET)
	cp $(TARGET) /usr/local/bin/

.PHONY: all clean check-cuda show-config run-example install